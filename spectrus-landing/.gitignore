# =========================================
# TÁCTICA DE CARGAMENTO PESADO (VIDEOS)
# =========================================
# 1. Ignorar todos los videos pesados en la carpeta raíz
/public/videos/*.mp4
/public/videos/*.webm
/public/videos/*.mov

# 2. Excepción: Permitir SIEMPRE que se suban las previas ligeras
!/public/videos/previews/*.mp4
!/public/videos/previews/*.webm
!/public/videos/previews/*.mov